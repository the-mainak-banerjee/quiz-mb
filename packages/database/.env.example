# Development Supabase only. Never commit real credentials.
# Prisma tooling uses the Supabase Session pooler (port 5432), not transaction mode.
# Copy the exact host and username from the development project's Connect dialog.
# Replace placeholders and percent-encode special characters in the password.
# This variable is tooling-only; never expose it to apps/web.
DIRECT_DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
