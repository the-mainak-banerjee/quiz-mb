generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @db.VarChar(100)
  email               String               @unique @db.VarChar(254)
  passwordHash        String
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  sessions            AuthSession[]
  projects            Project[]
  quizzes             Quiz[]
  media               MediaAsset[]
  projectAssociations ProjectAssociation[]
  quizRegistrations   QuizRegistration[]
  hostedLiveSessions  LiveQuizSession[]
  liveParticipations  ParticipantSession[]

  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid
  refreshTokenHash String    @unique @db.VarChar(64)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime  @db.Timestamptz(3)
  lastUsedAt       DateTime? @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  userAgent        String?   @db.VarChar(512)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([familyId])
  @@map("auth_sessions")
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  LOBBY
  LIVE
  COMPLETED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  DESCRIPTIVE
}

enum MediaPurpose {
  QUIZ_COVER
  QUESTION_IMAGE
}

enum MediaStatus {
  PENDING
  READY
  DELETED
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
}

enum LiveSessionState {
  LOBBY
  LIVE_IDLE
  QUESTION_ACTIVE
  QUESTION_RESULT
  LEADERBOARD
  COMPLETED
}

model Project {
  id           String               @id @default(uuid()) @db.Uuid
  ownerUserId  String               @db.Uuid
  name         String               @db.VarChar(60)
  description  String               @default("") @db.VarChar(240)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)
  owner        User                 @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  quizzes      Quiz[]
  associations ProjectAssociation[]

  @@index([ownerUserId, createdAt])
  @@map("projects")
}

model Quiz {
  id                             String               @id @default(uuid()) @db.Uuid
  publicId                       String               @unique
  projectId                      String               @db.Uuid
  creatorUserId                  String               @db.Uuid
  title                          String               @db.VarChar(90)
  description                    String               @default("")
  registrationLimit              Int
  defaultQuestionDurationSeconds Int
  allowLateJoin                  Boolean              @default(true)
  plannedStartAt                 DateTime?            @db.Timestamptz(3)
  status                         QuizStatus           @default(DRAFT)
  coverMediaId                   String?              @db.Uuid
  createdAt                      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime             @updatedAt @db.Timestamptz(3)
  publishedAt                    DateTime?            @db.Timestamptz(3)
  project                        Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  creator                        User                 @relation(fields: [creatorUserId], references: [id], onDelete: Restrict)
  cover                          MediaAsset?          @relation("QuizCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  media                          MediaAsset[]         @relation("QuizUploads")
  questions                      Question[]
  registrations                  QuizRegistration[]
  createdAssociations            ProjectAssociation[] @relation("AssociationCreatedViaQuiz")
  liveSessions                   LiveQuizSession[]

  @@index([projectId, status])
  @@index([creatorUserId, createdAt])
  @@map("quizzes")
}

model ProjectAssociation {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @db.Uuid
  userId           String   @db.Uuid
  createdViaQuizId String?  @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdViaQuiz   Quiz?    @relation("AssociationCreatedViaQuiz", fields: [createdViaQuizId], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([userId, createdAt])
  @@map("project_associations")
}

model QuizRegistration {
  id           String             @id @default(uuid()) @db.Uuid
  quizId       String             @db.Uuid
  userId       String             @db.Uuid
  status       RegistrationStatus @default(REGISTERED)
  registeredAt DateTime           @default(now()) @db.Timestamptz(3)
  cancelledAt  DateTime?          @db.Timestamptz(3)
  quiz         Quiz               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([quizId, userId])
  @@index([quizId, status])
  @@index([userId, status])
  @@index([userId, registeredAt])
  @@map("quiz_registrations")
}

model Question {
  id                      String           @id @default(uuid()) @db.Uuid
  quizId                  String           @db.Uuid
  type                    QuestionType
  text                    String
  position                Int
  durationOverrideSeconds Int?
  imageMediaId            String?          @db.Uuid
  createdAt               DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime         @updatedAt @db.Timestamptz(3)
  quiz                    Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  image                   MediaAsset?      @relation("QuestionImage", fields: [imageMediaId], references: [id], onDelete: SetNull)
  options                 QuestionOption[]

  @@unique([quizId, position])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  text       String
  position   Int
  isCorrect  Boolean
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
  @@map("question_options")
}

model MediaAsset {
  id          String       @id @default(uuid()) @db.Uuid
  ownerUserId String       @db.Uuid
  quizId      String       @db.Uuid
  purpose     MediaPurpose
  status      MediaStatus  @default(PENDING)
  bucket      String
  objectPath  String
  fileName    String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  readyAt     DateTime?    @db.Timestamptz(3)
  owner       User         @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  quiz        Quiz         @relation("QuizUploads", fields: [quizId], references: [id], onDelete: Cascade)
  covers      Quiz[]       @relation("QuizCover")
  images      Question[]   @relation("QuestionImage")

  @@unique([bucket, objectPath])
  @@index([ownerUserId, quizId])
  @@map("media_assets")
}

// One live execution of a quiz. Partial unique indexes in the migration allow
// at most one unfinished session per host and per quiz.
model LiveQuizSession {
  id            String               @id @default(uuid()) @db.Uuid
  quizId        String               @db.Uuid
  hostUserId    String               @db.Uuid
  state         LiveSessionState     @default(LOBBY)
  allowLateJoin Boolean
  startedAt     DateTime?            @db.Timestamptz(3)
  endedAt       DateTime?            @db.Timestamptz(3)
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)
  quiz          Quiz                 @relation(fields: [quizId], references: [id], onDelete: Cascade)
  host          User                 @relation(fields: [hostUserId], references: [id], onDelete: Restrict)
  participants  ParticipantSession[]

  @@index([quizId, state])
  @@index([hostUserId, state])
  @@map("live_quiz_sessions")
}

// A registered user who actually entered a live session.
model ParticipantSession {
  id            String          @id @default(uuid()) @db.Uuid
  liveSessionId String          @db.Uuid
  userId        String          @db.Uuid
  firstJoinedAt DateTime        @default(now()) @db.Timestamptz(3)
  lastJoinedAt  DateTime        @default(now()) @db.Timestamptz(3)
  leftAt        DateTime?       @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  liveSession   LiveQuizSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveSessionId, userId])
  @@index([userId])
  @@map("participant_sessions")
}
