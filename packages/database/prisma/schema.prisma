generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @db.VarChar(100)
  email               String               @unique @db.VarChar(254)
  passwordHash        String
  /// Null until the email address is verified with a one-time code.
  emailVerifiedAt     DateTime?            @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  sessions            AuthSession[]
  verificationCodes   VerificationCode[]
  projects            Project[]
  quizzes             Quiz[]
  media               MediaAsset[]
  projectAssociations ProjectAssociation[]
  quizRegistrations   QuizRegistration[]
  hostedLiveSessions  LiveQuizSession[]
  liveParticipations  ParticipantSession[]
  answerSubmissions   AnswerSubmission[]
  quizResults         QuizResult[]

  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid
  refreshTokenHash String    @unique @db.VarChar(64)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime  @db.Timestamptz(3)
  lastUsedAt       DateTime? @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  userAgent        String?   @db.VarChar(512)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([familyId])
  @@map("auth_sessions")
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// One live code per user and purpose; replaced on resend, deleted once used.
model VerificationCode {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  purpose   OtpPurpose
  codeHash  String     @db.VarChar(64)
  expiresAt DateTime   @db.Timestamptz(3)
  attempts  Int        @default(0)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose])
  @@index([expiresAt])
  @@map("verification_codes")
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  LOBBY
  LIVE
  COMPLETED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  DESCRIPTIVE
}

enum MediaPurpose {
  QUIZ_COVER
  QUESTION_IMAGE
}

enum MediaStatus {
  PENDING
  READY
  DELETED
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
}

enum LiveSessionState {
  LOBBY
  LIVE_IDLE
  QUESTION_ACTIVE
  QUESTION_RESULT
  LEADERBOARD
  COMPLETED
}

enum AskedQuestionStatus {
  ACTIVE
  COMPLETED
}

enum AnswerStatus {
  SUBMITTED
  NOT_ATTEMPTED
}

model Project {
  id           String               @id @default(uuid()) @db.Uuid
  ownerUserId  String               @db.Uuid
  name         String               @db.VarChar(60)
  description  String               @default("") @db.VarChar(240)
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(3)
  owner        User                 @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  quizzes      Quiz[]
  associations ProjectAssociation[]

  @@index([ownerUserId, createdAt])
  @@map("projects")
}

model Quiz {
  id                             String               @id @default(uuid()) @db.Uuid
  publicId                       String               @unique
  projectId                      String               @db.Uuid
  creatorUserId                  String               @db.Uuid
  title                          String               @db.VarChar(90)
  description                    String               @default("")
  registrationLimit              Int
  defaultQuestionDurationSeconds Int
  allowLateJoin                  Boolean              @default(true)
  plannedStartAt                 DateTime?            @db.Timestamptz(3)
  status                         QuizStatus           @default(DRAFT)
  coverMediaId                   String?              @db.Uuid
  createdAt                      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime             @updatedAt @db.Timestamptz(3)
  publishedAt                    DateTime?            @db.Timestamptz(3)
  project                        Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  creator                        User                 @relation(fields: [creatorUserId], references: [id], onDelete: Restrict)
  cover                          MediaAsset?          @relation("QuizCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  media                          MediaAsset[]         @relation("QuizUploads")
  questions                      Question[]
  registrations                  QuizRegistration[]
  createdAssociations            ProjectAssociation[] @relation("AssociationCreatedViaQuiz")
  liveSessions                   LiveQuizSession[]

  @@index([projectId, status])
  @@index([creatorUserId, createdAt])
  @@map("quizzes")
}

model ProjectAssociation {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @db.Uuid
  userId           String   @db.Uuid
  createdViaQuizId String?  @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdViaQuiz   Quiz?    @relation("AssociationCreatedViaQuiz", fields: [createdViaQuizId], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([userId, createdAt])
  @@map("project_associations")
}

model QuizRegistration {
  id           String             @id @default(uuid()) @db.Uuid
  quizId       String             @db.Uuid
  userId       String             @db.Uuid
  status       RegistrationStatus @default(REGISTERED)
  registeredAt DateTime           @default(now()) @db.Timestamptz(3)
  cancelledAt  DateTime?          @db.Timestamptz(3)
  quiz         Quiz               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([quizId, userId])
  @@index([quizId, status])
  @@index([userId, status])
  @@index([userId, registeredAt])
  @@map("quiz_registrations")
}

model Question {
  id                      String           @id @default(uuid()) @db.Uuid
  quizId                  String           @db.Uuid
  type                    QuestionType
  text                    String
  position                Int
  durationOverrideSeconds Int?
  imageMediaId            String?          @db.Uuid
  createdAt               DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime         @updatedAt @db.Timestamptz(3)
  quiz                    Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  image                   MediaAsset?      @relation("QuestionImage", fields: [imageMediaId], references: [id], onDelete: SetNull)
  options                 QuestionOption[]
  askedQuestions          AskedQuestion[]

  @@unique([quizId, position])
  @@map("questions")
}

model QuestionOption {
  id         String                   @id @default(uuid()) @db.Uuid
  questionId String                   @db.Uuid
  text       String
  position   Int
  isCorrect  Boolean
  question   Question                 @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selections AnswerSubmissionOption[]

  @@unique([questionId, position])
  @@map("question_options")
}

model MediaAsset {
  id          String       @id @default(uuid()) @db.Uuid
  ownerUserId String       @db.Uuid
  quizId      String       @db.Uuid
  purpose     MediaPurpose
  status      MediaStatus  @default(PENDING)
  bucket      String
  objectPath  String
  fileName    String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  readyAt     DateTime?    @db.Timestamptz(3)
  owner       User         @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  quiz        Quiz         @relation("QuizUploads", fields: [quizId], references: [id], onDelete: Cascade)
  covers      Quiz[]       @relation("QuizCover")
  images      Question[]   @relation("QuestionImage")

  @@unique([bucket, objectPath])
  @@index([ownerUserId, quizId])
  @@map("media_assets")
}

// One live execution of a quiz. Partial unique indexes in the migration allow
// at most one unfinished session per host and per quiz.
model LiveQuizSession {
  id                      String               @id @default(uuid()) @db.Uuid
  quizId                  String               @db.Uuid
  hostUserId              String               @db.Uuid
  state                   LiveSessionState     @default(LOBBY)
  allowLateJoin           Boolean
  startedAt               DateTime?            @db.Timestamptz(3)
  endedAt                 DateTime?            @db.Timestamptz(3)
  /// Set when the host reveals the final leaderboard to participants.
  finalLeaderboardShownAt DateTime?            @db.Timestamptz(3)
  createdAt               DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime             @updatedAt @db.Timestamptz(3)
  quiz                    Quiz                 @relation(fields: [quizId], references: [id], onDelete: Cascade)
  host                    User                 @relation(fields: [hostUserId], references: [id], onDelete: Restrict)
  participants            ParticipantSession[]
  askedQuestions          AskedQuestion[]
  results                 QuizResult[]

  @@index([quizId, state])
  @@index([hostUserId, state])
  @@map("live_quiz_sessions")
}

// A registered user who actually entered a live session.
model ParticipantSession {
  id            String          @id @default(uuid()) @db.Uuid
  liveSessionId String          @db.Uuid
  userId        String          @db.Uuid
  firstJoinedAt DateTime        @default(now()) @db.Timestamptz(3)
  lastJoinedAt  DateTime        @default(now()) @db.Timestamptz(3)
  leftAt        DateTime?       @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  liveSession   LiveQuizSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveSessionId, userId])
  @@index([userId])
  @@map("participant_sessions")
}

// A question the host actually presented in a live session. Only these rows
// count towards results; the live order is sequenceNumber, not position.
model AskedQuestion {
  id              String              @id @default(uuid()) @db.Uuid
  liveSessionId   String              @db.Uuid
  questionId      String              @db.Uuid
  sequenceNumber  Int
  status          AskedQuestionStatus @default(ACTIVE)
  durationSeconds Int
  startedAt       DateTime            @db.Timestamptz(3)
  endsAt          DateTime            @db.Timestamptz(3)
  completedAt     DateTime?           @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  liveSession     LiveQuizSession     @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  question        Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  submissions     AnswerSubmission[]

  @@unique([liveSessionId, questionId])
  @@unique([liveSessionId, sequenceNumber])
  @@index([liveSessionId, status])
  @@index([questionId])
  @@map("asked_questions")
}

// One accepted answer per participant per asked question. A participant with
// no row was not attempted; that outcome is derived, not stored eagerly.
model AnswerSubmission {
  id              String                   @id @default(uuid()) @db.Uuid
  askedQuestionId String                   @db.Uuid
  userId          String                   @db.Uuid
  status          AnswerStatus             @default(SUBMITTED)
  answerText      String?
  submittedAt     DateTime?                @db.Timestamptz(3)
  responseTimeMs  Int?
  isCorrect       Boolean?
  pointsAwarded   Int                      @default(0)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  askedQuestion   AskedQuestion            @relation(fields: [askedQuestionId], references: [id], onDelete: Cascade)
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  options         AnswerSubmissionOption[]

  @@unique([askedQuestionId, userId])
  @@index([askedQuestionId, status])
  @@index([userId, createdAt])
  @@map("answer_submissions")
}

model AnswerSubmissionOption {
  answerSubmissionId String           @db.Uuid
  questionOptionId   String           @db.Uuid
  submission         AnswerSubmission @relation(fields: [answerSubmissionId], references: [id], onDelete: Cascade)
  option             QuestionOption   @relation(fields: [questionOptionId], references: [id], onDelete: Cascade)

  @@id([answerSubmissionId, questionOptionId])
  @@index([questionOptionId])
  @@map("answer_submission_options")
}

// Final result of one participant, written once when the quiz ends. Counts
// cover asked scored (non-descriptive) questions only.
model QuizResult {
  id                String          @id @default(uuid()) @db.Uuid
  liveSessionId     String          @db.Uuid
  userId            String          @db.Uuid
  totalScore        Int
  rank              Int
  correctCount      Int
  incorrectCount    Int
  notAttemptedCount Int
  finalizedAt       DateTime        @default(now()) @db.Timestamptz(3)
  liveSession       LiveQuizSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([liveSessionId, userId])
  @@index([liveSessionId, rank])
  @@index([userId, finalizedAt])
  @@map("quiz_results")
}
