{
  "name": "quiz-mb",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:check": "pnpm --filter @quizmb/database db:check"
  },
  "devDependencies": {
    "turbo": "2.11.3",
    "typescript": "5.9.3",
    "eslint": "9.39.5",
    "prettier": "3.9.9"
  }
}
