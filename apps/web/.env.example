NEXT_PUBLIC_API_URL=http://localhost:4000
# Production: https://api.quizmb.com. Browser and server use the same API.

# Canonical production origin (never use a preview/staging deployment URL).
SITE_URL=https://quizmb.com
# Required for non-Vercel live deployments; local/staging/preview stay noindex.
# Vercel supplies VERCEL_ENV automatically. Set DEPLOYMENT_ENV=staging on
# staging projects even if Vercel calls that project's deployment production.
DEPLOYMENT_ENV=development
