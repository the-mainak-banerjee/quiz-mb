NODE_ENV=development
PORT=4000
HOST=localhost
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Database connections in the API's pool (default 10).
DATABASE_POOL_MAX=10
# Proxies in front of the API whose X-Forwarded-For entry is trusted for the
# client IP (rate limits). 0 locally; 1 on Render.
TRUST_PROXY_HOPS=0

# API runtime only; never expose these variables to apps/web.
# Supabase transaction pooler for Vercel runtime; use your exact pooler host.
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_43_CHARACTERS
AUTH_ACCESS_TTL_SECONDS=900
AUTH_SESSION_TTL_SECONDS=2592000
# Production only: AUTH_COOKIE_DOMAIN=quizmb.com (trusted subdomains only).
# Leave unset on localhost. Refresh cookies always remain API-host-only.
# Base64-encoded PEM of the CA downloaded from Supabase Database Settings.
# Required when the pooler's issuer is not in Node's standard trust store.
# DATABASE_SSL_CA_BASE64=BASE64_ENCODED_SUPABASE_CA_PEM

# Server-only Supabase Storage credentials. Never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_DEVELOPMENT_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=quizmb-media

# Transactional email (Resend) for verification and password reset codes.
# EMAIL_FROM must use a domain verified in Resend. Required in production.
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
EMAIL_FROM="QuizMB <no-reply@your-verified-domain.com>"
# Optional: shown in emails as the address people can write to.
# SUPPORT_EMAIL=you@example.com

# Live sessions: presence, active-device tracking and locks (Phase 5).
# Upstash Redis TCP URL (Console → database → "Redis" connect, TLS). Required
# in production; tests and REST-only runs can omit it.
REDIS_URL="rediss://default:REPLACE_WITH_PASSWORD@REPLACE_WITH_HOST.upstash.io:6379"
