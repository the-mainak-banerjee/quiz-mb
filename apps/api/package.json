{
  "name": "@quizmb/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --env-file=.env --import tsx --test --test-concurrency=1 tests/*.integration.test.ts",
    "storage:setup": "node --env-file=.env --import tsx scripts/setup-storage.ts"
  },
  "dependencies": {
    "@quizmb/contracts": "workspace:*",
    "@quizmb/database": "workspace:*",
    "@supabase/storage-js": "2.117.2",
    "argon2": "0.45.1",
    "cookie": "2.0.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "pino": "10.3.1",
    "socket.io": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@quizmb/config": "workspace:*",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15"
  }
}
